# ── DuckDNS ──────────────────────────────────────────────────────
# Register at https://www.duckdns.org (login with GitHub/Google)
# Create a subdomain, e.g., "onlymonkes" → onlymonkes.duckdns.org
DUCKDNS_SUBDOMAIN=onlymonkes
DUCKDNS_TOKEN=your-duckdns-token-here

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme-strong-password

# ── Caddy metrics auth ──────────────────────────────────────────
# Generate hash: docker run caddy caddy hash-password --plaintext 'yourpassword'
METRICS_USER=admin
METRICS_BCRYPT_HASH=$2a$14$changeme

# ── Bot secrets (copy from Monke_Eliza .env) ─────────────────────
# XMTP
XMTP_GROUP_ID=d9c4dd4a4a1dd9eed09756fa8329bad4
XMTP_ENV=production

# APIs
HELIUS_API_KEY=
BIRDEYE_API_KEY=
GIPHY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# LLM Chain
GROQ_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=

# LiveKit (for bot-side room events, if any)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Solana
SOLANA_RPC_URL=
SOLANA_PRIVATE_KEY=

# Sentry (optional)
SENTRY_DSN=

# ── LightRAG (set in .env.lightrag instead) ─────────────────────
# LIGHTRAG_URL is auto-set to http://lightrag:9621 in docker-compose
