{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "native-3.1",
      "android": {
        "gradleCommand": ":app:assembleProductionDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "native-3.1",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProductionRelease"
      }
    },
    "production": {
      "channel": "native-3.1",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleProductionRelease"
      }
    },
    "canary": {
      "distribution": "internal",
      "channel": "native-3.1",
      "android": {
        "gradleCommand": ":app:assembleCanaryRelease"
      }
    },
    "next-3.1": {
      "distribution": "internal",
      "channel": "native-3.1",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleNextRelease"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
