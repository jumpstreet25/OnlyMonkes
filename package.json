{
  "name": "onlymonkes",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "_securityOverridesNote": "Overrides below address findings from SECURITY_AUDIT_2026-05-02.md. protobufjs <7.5.5 = CVSS 9.8 RCE; remaining are HIGH transitive vulns flagged by npm audit. Sit dormant in this file until next `npm install` + APK build cycle (intentional — keeps current OTA bundle / lockfile unchanged).",
  "overrides": {
    "protobufjs": "^7.5.5",
    "undici": "^6.21.0",
    "@expo/server": { "undici": "^7.28.0" },
    "@xmldom/xmldom": "^0.9.0",
