  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "e2e:build": "detox build --configuration android.emu.debug",
    "e2e:test": "detox test --configuration android.emu.debug",
    "eas-build-pre-install": "if [ -n \"$GOOGLE_SERVICES_JSON\" ] && [ -f \"$GOOGLE_SERVICES_JSON\" ]; then cp \"$GOOGLE_SERVICES_JSON\" android/app/google-services.json && echo \"[eas-build-pre-install] google-services.json restored from secret\"; else echo \"[eas-build-pre-install] no GOOGLE_SERVICES_JSON env var or file missing (local build)\"; fi",
    "eas-build-post-install": "echo '[eas-build-post-install] fetching Skia prebuilt binaries' && npx install-skia",
    "postinstall": "npx install-skia 2>/dev/null || echo '[postinstall] install-skia skipped (only needed for native builds)'"
  },
