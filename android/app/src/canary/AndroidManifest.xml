<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 2026-07-23: EAS Update requires an expo-channel-name request header
         per flavor (matches eas.json's "canary" build profile channel).
         `eas build` injects this automatically via its config-plugin
         prebuild step; a raw `./gradlew assemble...` or `expo prebuild`-free
         bare-workflow build does not, so it must live here instead — without
         it, every update check 400s ("channel-name required"), which can
         trigger expo-updates' error-recovery reload path.

         2026-08-05: the meta-data name was wrong for expo-updates ~29.0.18 —
         see the matching note in ../production/AndroidManifest.xml for the
         full trace through UpdatesConfiguration.kt. This SDK version reads
         the literal key "expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY",
         not "EXPO_UPDATE_REQUEST_HEADERS" — the old name silently resolved
         to an empty headers map and broke OTA entirely on both flavors. -->
    <application>
        <meta-data android:name="expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY" android:value="{&quot;expo-channel-name&quot;:&quot;preview&quot;}"/>
    </application>
</manifest>
